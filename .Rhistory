n = 20 ; ntest = 20
p = 8
rho <- 0.5
p_true = 8 # number of non-zero coefficients
sigma = 6
Sigma <- matrix(rho, nrow = p, ncol = p)
for(i in 1:p){
for(j in 1:p){
Sigma[i,j] = 0.5^abs(i-j)
}
}
nmeth = 6
see = rep(NA,B*nmeth)
support = rep(NA,B*nmeth)
ts = rep(NA,B*nmeth)
tpr = rep(NA,B*nmeth)
test_error = rep(NA,B*nmeth)
su_consistence = rep(NA,B*nmeth)
st_consistence = rep(NA,B*nmeth)
variable_magnitude = rep(NA,B*nmeth)
for(b in 1:B){
x = mvrnorm(n = n, mu = rep(0, p), Sigma = Sigma)
beta = c(3,1.5,0,0,2,0,0,0)
y = x %*% beta + rnorm(n,0,sigma)
if(b==1){cat("SNR:", crossprod(beta, Sigma) %*% beta / sigma^2)}
xtest = mvrnorm(n = ntest, mu = rep(0, p), Sigma = Sigma)
ytest = xtest %*% beta + rnorm(ntest,0,sigma)
sim = run_simulation(x,y,xtest,ytest,beta,n,ntest)
## see
see[((b-1)*nmeth+1):(b*nmeth)] = sim$see
## support
support[((b-1)*nmeth+1):(b*nmeth)] = sim$support
## true signal detection rate
ts[((b-1)*nmeth+1):(b*nmeth)] = sim$signal_detection
## tpr
tpr[((b-1)*nmeth+1):(b*nmeth)] = sim$tpr
## test error
test_error[((b-1)*nmeth+1):(b*nmeth)] = sim$test_error
## sign consistency with uni
su_consistence[((b-1)*nmeth+1):(b*nmeth)] = sim$su_consistence
## sign consistency with true
st_consistence[((b-1)*nmeth+1):(b*nmeth)] = sim$st_consistence
## univariate magnitude
variable_magnitude[((b-1)*nmeth+1):(b*nmeth)] = sim$variable_magnitude
}
plot_simulation(see,support,ts, tpr, test_error,su_consistence,st_consistence, variable_magnitude)
foldid = sample(rep(1:5, length.out = n))
x = mvrnorm(n = n, mu = rep(0, p), Sigma = Sigma)
beta = c(3,1.5,0,0,2,0,0,0)
y = x %*% beta + rnorm(n,0,sigma)
lsfit = cv.sulnet(x,y,foldid = foldid, standardize = TRUE)
adapf = 1/pmax(coef(lsfit)[-1],1e-6)
adals = cv.sulnet(x,y, foldid = foldid, pf = adapf, standardize = TRUE)
adasuni1 = cv.sulnet2D(x,y,foldid = foldid, method = "adasuni")
adasuni2 = cv.sulnet2D(x,y, foldid = foldid, method = "adasuni2")
suni = cv.sulnet2D(x,y,foldid = foldid)
uni = cv.uniLasso(x,y,foldid = foldid)
cat("ls:", which(coef(lsfit)[-1]!=0))
cat("\nadals:", which(coef(adals)[-1]!=0))
cat("\nadasuni:", which(coef(adasuni1)[[1]][-1]!=0))
cat("\nadasuni2:", which(coef(adasuni2)[[1]][-1]!=0))
cat("\nsuni:",which(coef(suni)[[1]][-1]!=0))
cat("\nunils:",which(uni$glmnet.fit$beta[,uni$lambda == uni$lambda.min]!=0))
