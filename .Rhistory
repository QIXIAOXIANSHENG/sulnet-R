sign_ls = mean(abs(sign(beta_ls[beta != 0]) - sign(beta[beta != 0]) <= 1))
sigc_ls = mean((beta_ls != 0) == (beta != 0))
tpr_ls = sum((beta_ls != 0) & (beta != 0))/sum(beta != 0)
fpr_ls = sum((beta_ls != 0) & (beta == 0))/sum(beta == 0)
fit_adals = cv.sulnet(x,y, foldid = foldid,
pf = 1/pmax(abs(beta_ls), 1e-6))
beta_adals = coef(fit_adals, s = fit_adals$lambda.min)[-1]
ypred_adals = predict(fit_adals, xtest, s = fit_ls$lambda.min)
mse_adals = mean((ytest - ypred_adals)^2)
ssee_adals = sum((beta - beta_adals)^2)
rpe_adals = mean((ypred_adals - xtest %*% beta)^2)/sigma^2
sign_adals = mean(abs(sign(beta_adals[beta != 0]) - sign(beta[beta != 0]) <= 1))
sigc_adals = mean((beta_adals != 0) == (beta != 0))
tpr_adals = sum((beta_adals != 0) & (beta != 0))/sum(beta != 0)
fpr_adals = sum((beta_adals != 0) & (beta == 0))/sum(beta == 0)
x_new = x[, which(as.vector(beta_ls) != 0)]
ols = lm.fit(cbind(1, x_new), y)$coefficients[-1]
if(length(ols) == 0){
beta_adaols = rep(0,length(beta))
ypred_adaols = rep(0, ntest)
}else{
