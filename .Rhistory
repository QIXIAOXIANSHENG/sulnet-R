beta = c(runif(p_true),rep(0,p-p_true))
y = x %*% beta + rnorm(n,0,sigma)
lsfit = cv.sulnet(x,y, foldid = foldid)
a = abs(coef(lsfit))[-1]; a = mean(a[a>0])
adalsfit = cv.sulnet(x,y,foldid = foldid,
pf = 1/sapply(coef(lsfit)[-1],
function(x){
max(abs(x),a)
}))
sum((as.vector(coef(adalsfit, s = "lambda.min")[-1]) - beta)^2)
