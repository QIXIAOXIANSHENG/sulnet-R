exclude = jd[-1])
adapf <- as.double(1/sapply(coef(lsfit)[-1], function(x) max(abs(x),1e-6)))
adafit <- cv.sulnet(x, y, method = "ls", standardize = TRUE, intercept = TRUE,
pf = adapf, lambda2 = lam2,
exclude = jd[-1])
}
